{
  "name": "customer-loyalty-rewards",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "build": "npm run build:api && npm --prefix web run build",
    "start": "node dist/main.js",
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "db:setup": "ts-node src/setup.ts",
    "test:e2e": "node test/e2e.cjs",
    "mail:dispatch": "ts-node src/notifications/dispatch.ts",
    "mail:preview": "ts-node src/notifications/preview.ts",
    "test:integration": "node test/integration.cjs",
    "build:api": "tsc -p tsconfig.json",
    "web:dev": "npm --prefix web run dev",
    "dev": "node tools/dev.mjs",
    "accounts:seed": "ts-node src/seed-accounts.ts",
    "start:cloud": "node tools/start.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/mapped-types": "^2.1.0",
    "typeorm": "^0.3.28",
    "mysql2": "^3.15.0",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "helmet": "^8.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "dotenv": "^17.2.0",
    "nodemailer": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "~5.9.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "@types/nodemailer": "^7.0.0"
  }
}
