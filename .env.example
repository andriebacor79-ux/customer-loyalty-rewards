PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=loyalty_app
DB_PASSWORD=SET_YOUR_LOCAL_DATABASE_PASSWORD
DB_NAME=loyalty_v2
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
MANAGER_EMAIL=manager@example.test
MANAGER_PASSWORD=CHOOSE_A_PASSWORD_AT_LEAST_12_CHARACTERS
# Optional HTTPS. Use a trusted certificate for a real deployment.
TLS_CERT_FILE=
TLS_KEY_FILE=
# Optional email transport. No emails are sent automatically by API requests.
# For a local SMTP capture server (e.g. Mailpit): localhost, port 1025,
# SMTP_ALLOW_INSECURE_LOCAL=true. Never enable that flag for a remote provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
SMTP_ALLOW_INSECURE_LOCAL=false

# Optional frontend demonstration accounts (fresh accounts only; never resets passwords).
STAFF_EMAIL=andriebacor79@gmail.com
STAFF_PASSWORD=CHOOSE_A_DIFFERENT_PASSWORD_AT_LEAST_12_CHARACTERS
CUSTOMER_EMAIL=bebekosijazmin021@gmail.com
CUSTOMER_PASSWORD=CHOOSE_ANOTHER_PASSWORD_AT_LEAST_12_CHARACTERS
# Remote MySQL must use verified TLS. Add your provider CA if required.
DB_SSL=false
DB_CA_CERT=
# Render terminates HTTPS. Do not configure local TLS files there.
# INIT_DATABASE=true only for a new, empty dedicated cloud database.
INIT_DATABASE=false
