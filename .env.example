PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=loyalty_app
DB_PASSWORD=SET_YOUR_LOCAL_DATABASE_PASSWORD
DB_NAME=loyalty_v2
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
MANAGER_EMAIL=manager@example.test
MANAGER_PASSWORD=CHOOSE_A_PASSWORD_AT_LEAST_12_CHARACTERS
# Optional HTTPS. Use a trusted certificate for a real deployment.
TLS_CERT_FILE=
TLS_KEY_FILE=
# Optional email transport. No emails are sent automatically by API requests.
# For a local SMTP capture server (e.g. Mailpit): localhost, port 1025,
# SMTP_ALLOW_INSECURE_LOCAL=true. Never enable that flag for a remote provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
SMTP_ALLOW_INSECURE_LOCAL=false
