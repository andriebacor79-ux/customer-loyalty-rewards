{
  "info": {
    "name": "Loyalty v2 - Activities 3-6 aligned",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "27 routes, complete customer/reward CRUD, owner checks, Staff/Manager roles, accounts, ledger and email logs. Run in order. Set managerEmail/managerPassword locally. Pending email means queued, not sent."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1"
    },
    {
      "key": "managerEmail",
      "value": "manager@example.test"
    },
    {
      "key": "managerPassword",
      "value": ""
    },
    {
      "key": "runId",
      "value": ""
    },
    {
      "key": "demoPassword",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "staffToken",
      "value": ""
    },
    {
      "key": "customerToken",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if(pm.info.requestName.startsWith('01 -')){pm.collectionVariables.set('runId',Date.now().toString());pm.collectionVariables.set('demoPassword',pm.variables.replaceIn('Demo-{{$guid}}'));}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 - Protected route without token",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/customers",
        "header": [],
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401',()=>pm.response.to.have.status(401));",
              "pm.test('Standard error format',()=>{const b=pm.response.json();pm.expect(b.success).to.eql(false);pm.expect(b.errors).to.be.an('array');pm.expect(b.timestamp).to.be.a('string');});"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Public reward catalog",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/rewards",
        "header": [],
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
